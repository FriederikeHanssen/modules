nextflow_workflow {

    name "Test DeepSomatic scatter and gather"
    script "./scatter.nf"
    workflow "DEEPSOMATIC_SCATTER"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "deepsomatic"
    tag "gatk4/mergevcfs"

    test("bam - vcf - scatter and gather") {
        when {
            workflow {
                """
                def intervals = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed')
                input[0] = Channel.fromList(intervals.readLines().withIndex().collect { line, i ->
                    def bed = file('region_' + i + '.bed')
                    bed.text = line + '\\n'
                    [
                        [ id: 'pair_' + i ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.sorted.bam', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.sorted.bam.bai', checkIfExists: true),
                        bed
                    ]
                })
                input[1] = [[ id:'genome' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)]
                input[2] = [[ id:'genome' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)]
                input[3] = [[ id:'genome' ], []]
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert workflow.out.shards.collect { file(it[1]).name }.sort() == ['pair_0.vcf.gz', 'pair_1.vcf.gz'] },
                { assert workflow.out.shard_indexes.collect { file(it[1]).name }.sort() == ['pair_0.vcf.gz.tbi', 'pair_1.vcf.gz.tbi'] },
                { assert workflow.out.shards.every { path(it[1]).vcf.header.genotypeSamples == ['testT'] } },
                { assert workflow.out.vcf.collect { file(it[1]).name } == ['pair.vcf.gz'] },
                { assert workflow.out.tbi.collect { file(it[1]).name } == ['pair.vcf.gz.tbi'] },
                { assert path(workflow.out.vcf[0][1]).vcf.header.genotypeSamples == ['testT'] },
                {
                    def counts = workflow.out.shards.collect { shard ->
                        new java.util.zip.GZIPInputStream(file(shard[1]).newInputStream()).withCloseable { stream ->
                            stream.readLines().count { !it.startsWith('#') }
                        }
                    }.sort()
                    assert counts[0] == 0
                    assert counts[1] > 0
                }
            )
        }
    }
}
