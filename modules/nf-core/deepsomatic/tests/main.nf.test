    test("bam - vcf - override empty") {
        when {
            params {
                module_args = '--sample_name_tumor customT --postprocess_variants_extra_args="sample_name=obsolete,qual_filter=7"'
                output_gvcf = false
            }
            process {
                """
                def bed = file('region.bed')
                bed.text = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed').readLines()[1] + '\\n'
                input[0] = [
                    [ id:'pair' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.sorted.bam.bai', checkIfExists: true),
                    bed
                ]
                input[1] = [[ id:'genome' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)]
                input[2] = [[ id:'genome' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)]
                input[3] = [[ id:'genome' ], []]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert process.out.vcf.collect { file(it[1]).name } == ['pair.vcf.gz'] },
                { assert process.out.vcf_tbi.collect { file(it[1]).name } == ['pair.vcf.gz.tbi'] },
                { assert process.out.gvcf.collect { file(it[1]).name } == [] },
                { assert process.out.gvcf_tbi.collect { file(it[1]).name } == [] },
                { assert path(process.out.vcf[0][1]).vcf.header.genotypeSamples == ['customT'] },
                {
                    def lines = new java.util.zip.GZIPInputStream(file(process.out.vcf[0][1]).newInputStream()).withCloseable { it.readLines() }
                    assert lines.count { !it.startsWith('#') } == 0
                },
                {
                    def log = path(process.out.vcf[0][1]).parent.resolve('.command.log').text
                    assert log.contains('--qual_filter "7"')
                    assert !log.contains('obsolete')
                },
                { assert snapshot(
                    process.out.vcf.collect { [it[0], file(it[1]).name] },
                    process.out.vcf_tbi.collect { [it[0], file(it[1]).name] },
                    process.out.gvcf.collect { [it[0], file(it[1]).name] },
                    process.out.gvcf_tbi.collect { [it[0], file(it[1]).name] },
                    process.out.findAll { key, value -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

