                { assert process.out.vcf_tbi.collect { file(it[1]).name } == ['pair.vcf.gz.tbi'] },
                { assert process.out.gvcf.collect { file(it[1]).name } == ['pair.g.vcf.gz'] },
                { assert process.out.gvcf_tbi.collect { file(it[1]).name } == ['pair.g.vcf.gz.tbi'] },
                { assert snapshot(
                    process.out.vcf.collect { [it[0], file(it[1]).name] },
                    process.out.vcf_tbi.collect { [it[0], file(it[1]).name] },
                    process.out.gvcf.collect { [it[0], file(it[1]).name] },
                    process.out.gvcf_tbi.collect { [it[0], file(it[1]).name] },
                    process.out.findAll { key, value -> key.startsWith("versions") }
                ).match() }
            )
        }
    }
}
